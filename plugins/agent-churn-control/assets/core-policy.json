{
  "schema_version": "1.0",
  "policy_id": "agent-churn-control-core-v1",
  "churn_dimensions": ["test_repetition", "suite_overlap", "validation_proportionality", "review_research_repetition", "retry_tool_churn", "narration_churn", "artifact_churn", "planning_churn"],
  "material_progress_is_separate": true,
  "intervention_levels": ["bypass", "observe", "enforce", "promotion_gate"],
  "allowed_invalidation_reasons": ["candidate_changed", "dependency_changed", "policy_changed", "requirements_changed", "scope_changed", "evaluator_changed", "environment_changed", "transient_execution_failure", "prior_evidence_corrupt"],
  "allowed_changed_fields": ["candidate_digest", "dependency_digest", "policy_digest", "requirements_digest", "action_scope_digest", "evaluator_digest", "environment_digest", "prior_evidence_status"],
  "allowed_evidence_kinds": ["candidate_digest", "dependency_digest", "policy_digest", "requirements_digest", "action_scope_digest", "evaluator_digest", "environment_digest", "execution_trace_digest", "verifier_report_digest"],
  "max_transient_retries_per_work_key": 1,
  "automatic_retries": 0,
  "rate_states": ["below_80", "at_or_above_80", "at_or_above_97", "at_or_above_100", "missing", "stale"],
  "rate_effect": "advisory",
  "one_full_gate_per_frozen_identity": true,
  "numeric_savings_require_basis_receipt": true,
  "allowed_metric_names": ["input_tokens", "output_tokens", "cached_input_tokens", "elapsed_ms", "retry_count", "tool_calls", "cost_of_pass", "avoided_work_units"],
  "allowed_metric_units": ["tokens", "milliseconds", "count", "usd", "work_units"]
}
