{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Churn Control Event",
  "type": "object",
  "required": ["schema_version", "event_id", "task_id", "attempt_id", "action_kind", "action_scope_digest", "requirements_digest", "policy_digest", "evaluator_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"$ref": "#/$defs/opaqueId"},
    "task_id": {"$ref": "#/$defs/opaqueId"},
    "attempt_id": {"$ref": "#/$defs/opaqueId"},
    "model_ref": {"oneOf": [{"$ref": "#/$defs/opaqueId"}, {"type": "null"}]},
    "action_kind": {"enum": ["targeted_test", "broad_test", "premium_review", "retry", "tool_call", "panel", "plan_revision", "artifact", "promotion"]},
    "action_scope_digest": {"$ref": "#/$defs/digest"},
    "requirements_digest": {"$ref": "#/$defs/digest"},
    "candidate_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "dependency_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "evaluator_digest": {"$ref": "#/$defs/digest"},
    "environment_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "environment_independent": {"const": true},
    "evidence_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "evidence_accepted": {"type": "boolean"},
    "evidence_outcome": {"enum": ["pass", "local_failure"]},
    "reservation_receipt_id": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "material_progress": {
      "type": "object",
      "required": ["status", "evidence_digest"],
      "properties": {
        "status": {"enum": ["yes", "no", "unknown"]},
        "evidence_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "promotion_requested": {"type": "boolean"},
    "promotion_evidence": {
      "type": "object",
      "required": ["frozen_identity_complete", "targeted_checks_pass", "full_gate_pass", "package_integrity_pass", "authority_map_pass"],
      "properties": {
        "frozen_identity_complete": {"type": "boolean"},
        "targeted_checks_pass": {"type": "boolean"},
        "full_gate_pass": {"type": "boolean"},
        "package_integrity_pass": {"type": "boolean"},
        "authority_map_pass": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "fanout": {"oneOf": [{"$ref": "#/$defs/fanout"}, {"type": "null"}]},
    "invalidation": {"oneOf": [{"$ref": "#/$defs/invalidation"}, {"type": "null"}]},
    "rate_telemetry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state", "effect"],
          "properties": {
            "state": {"enum": ["below_80", "at_or_above_80", "at_or_above_97", "at_or_above_100", "missing", "stale"]},
            "effect": {"const": "advisory"}
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "value", "unit", "source_ref", "basis_receipt_ids"],
        "properties": {
          "name": {"enum": ["input_tokens", "output_tokens", "cached_input_tokens", "elapsed_ms", "retry_count", "tool_calls", "cost_of_pass", "avoided_work_units"]},
          "status": {"enum": ["measured", "derived", "unknown", "stale"]},
          "value": {"type": ["number", "null"]},
          "unit": {"enum": ["tokens", "milliseconds", "count", "usd", "work_units"]},
          "source_ref": {"oneOf": [{"$ref": "#/$defs/opaqueId"}, {"type": "null"}]},
          "basis_receipt_ids": {"type": "array", "items": {"$ref": "#/$defs/digest"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "opaqueId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"},
    "fanout": {
      "type": "object",
      "required": ["declared", "packet_id", "session_id", "packet_owner_agent_id", "integration_owner_agent_id", "write_contract", "assignments", "runtime_receipt_ref"],
      "properties": {
        "declared": {"const": true},
        "packet_id": {"$ref": "#/$defs/opaqueId"},
        "session_id": {"$ref": "#/$defs/opaqueId"},
        "packet_owner_agent_id": {"$ref": "#/$defs/opaqueId"},
        "integration_owner_agent_id": {"$ref": "#/$defs/opaqueId"},
        "write_contract": {"type": "object"},
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agent_id", "write_scopes"],
            "properties": {
              "agent_id": {"$ref": "#/$defs/opaqueId"},
              "write_scopes": {"type": "array", "items": {"$ref": "#/$defs/opaqueId"}}
            },
            "additionalProperties": false
          }
        },
        "runtime_receipt_ref": {"$ref": "#/$defs/opaqueId"}
      },
      "additionalProperties": false
    },
    "invalidation": {
      "type": "object",
      "required": ["schema_version", "invalidation_id", "invalidates", "action_scope_digest", "reason_code", "changes", "evidence"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "invalidation_id": {"$ref": "#/$defs/digest"},
        "invalidates": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/digest"}},
        "action_scope_digest": {"$ref": "#/$defs/digest"},
        "reason_code": {"enum": ["candidate_changed", "dependency_changed", "policy_changed", "requirements_changed", "scope_changed", "evaluator_changed", "environment_changed", "transient_execution_failure", "prior_evidence_corrupt"]},
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field", "before", "after"],
            "properties": {
              "field": {"enum": ["candidate_digest", "dependency_digest", "policy_digest", "requirements_digest", "action_scope_digest", "evaluator_digest", "environment_digest", "prior_evidence_status"]},
              "before": {"type": ["string", "null"]},
              "after": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "digest"],
            "properties": {
              "kind": {"enum": ["candidate_digest", "dependency_digest", "policy_digest", "requirements_digest", "action_scope_digest", "evaluator_digest", "environment_digest", "execution_trace_digest", "verifier_report_digest"]},
              "digest": {"$ref": "#/$defs/digest"}
            },
            "additionalProperties": false
          }
        },
        "issued_for_attempt_id": {"$ref": "#/$defs/opaqueId"},
        "note": {"type": "string", "maxLength": 512}
      },
      "additionalProperties": false
    }
  }
}
